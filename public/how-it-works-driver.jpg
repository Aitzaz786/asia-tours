<svg width="420" height="620" viewBox="0 0 420 620" fill="none" xmlns="http://www.w3.org/2000/svg">
  <rect width="420" height="620" rx="60" fill="#E8E8E8"/>
  <rect x="100" y="130" width="220" height="280" rx="20" fill="#D0D0D0"/>
  <!-- Beret/hat -->
  <ellipse cx="210" cy="200" rx="80" ry="25" fill="#222"/>
  <rect x="150" y="180" width="120" height="10" rx="5" fill="#222"/>
  <!-- Face -->
  <circle cx="210" cy="250" r="55" fill="#F0D0B0"/>
  <!-- Sunglasses -->
  <rect x="168" y="235" width="35" height="18" rx="8" fill="#222"/>
  <rect x="218" y="235" width="35" height="18" rx="8" fill="#222"/>
  <line x1="203" y1="244" x2="218" y2="244" stroke="#222" stroke-width="2"/>
  <!-- Smile -->
  <path d="M190 270 Q210 290 230 270" stroke="#C09070" stroke-width="2.5" fill="none" stroke-linecap="round"/>
  <!-- Body / shirt -->
  <rect x="155" y="310" width="130" height="100" rx="15" fill="#222"/>
  <!-- Arm on window -->
  <rect x="70" y="320" width="90" height="25" rx="12" fill="#F0D0B0"/>
  <!-- Car door line -->
  <rect x="40" y="360" width="340" height="180" rx="12" fill="#C4C4C4"/>
  <rect x="55" y="370" width="140" height="90" rx="10" fill="#A8D8EA"/>
  <!-- Window -->
  <rect x="55" y="370" width="140" height="90" rx="10" fill="#B0D8F0" opacity="0.7"/>
</svg>
